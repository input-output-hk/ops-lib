{ pkgs, ... }:
let
  inherit (pkgs.stdenv.hostPlatform) system;
  sources = import ../nix/sources.nix {};
  hub = (import sources.flake-compat {
    src = sources.auth-keys-hub;
    override-inputs.nixpkgs = {
      _type = "flake";
      legacyPackages.${system} = pkgs;
    };
  }).defaultNix;
in {
  imports = [ hub.nixosModules.auth-keys-hub ];

  programs.auth-keys-hub = {
    enable = true;
    package = hub.packages.${system}.auth-keys-hub;
    github.users = import ./ssh-users.nix "root";
  };

  # Root access when auth-keys-hub cannot fetch keys from GitHub; the two people maintaining these nixops deployments.
  users.users.root.openssh.authorizedKeys.keys = [
    "sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIJqRQMd6Ptlvv0msPoC97VNmrj2qjRrL2cnMEjZh2W8HAAAABHNzaDo= manveru@alpha"
    "ssh-rsa  john.lotoski@iohk.io"
  ];
}
